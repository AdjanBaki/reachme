# Kopiera den här filen till .env.local och fyll i de nycklar du har.
# .env.local är ignorerad av git. Dela aldrig nycklarna med någon.
# Saknas en nyckel körs den delen i exempelläge (inga riktiga anrop).

# --- AI (Claude) ---
# Skapa en nyckel på https://console.anthropic.com under "API keys".
ANTHROPIC_API_KEY=
# Valfritt: vilken Claude-modell som används. Lämna tomt för standard (claude-opus-5-5).
ANTHROPIC_MODEL=

# --- LinkedIn via Unipile (valfritt, för automatiska sökningar och utskick) ---
# Finns i Unipiles kontrollpanel (https://dashboard.unipile.com).
# API-nyckel: under "Access tokens".
UNIPILE_API_KEY=
# DSN: din serveradress, till exempel api1.unipile.com:13111 (utan https://).
UNIPILE_DSN=
# Konto-id för ditt kopplade LinkedIn-konto (under "Accounts").
UNIPILE_ACCOUNT_ID=
